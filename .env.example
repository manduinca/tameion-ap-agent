CIRCLE_API_KEY=TEST_API_KEY:...
CIRCLE_ENTITY_SECRET=<openssl rand -hex 32>

# Meta Model API. Contributor inputs and outputs may train future Meta models.
MODEL_API_KEY=
LLM_MODEL=muse-spark-1.3-contributor

# Optional shared credentials file (read-only), rather than duplicating Odoo/mail secrets.
ODOO_ENV_FILE=
# Real invoice content on Contributor is disabled until explicitly approved.
AP_ALLOW_REAL_DATA_TO_CONTRIBUTOR=no
# Local overrides; default data/ and wallets.json beside the project env file.
# AP_ENV_FILE=/path/to/private/.env
# AP_WALLETS_FILE=/path/to/private/wallets.json
# AP_DATA_DIR=/path/to/private/data
